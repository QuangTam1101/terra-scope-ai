# Backend only. Copy to backend/.env locally; never commit a real key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Matches the code default. Model availability still depends on your Google project.
# Alternative: gemini-3.8-flash. Legacy gemini-2.5-flash is deprecated.
GEMINI_MODEL=gemini-4-argon
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUESTS_PER_MINUTE=10
# Optional Phase 4 agent limits. Values above the documented safety caps are rejected.
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_STEPS=3
AGENT_TIMEOUT_SECONDS=40
AGENT_MAX_EVIDENCE_BYTES=96000

# Hosting: comma-separated exact frontend HTTPS origins; no trailing slash or wildcard.
# Keep local defaults for development; set the real Vercel/custom domain in the host dashboard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Start with one worker and warm-up disabled; enable after measuring memory and grid runtime.
WARM_UP=0
# Optional absolute writable cache directory. Docker defaults to /app/backend/.cache/grids.
# GRID_CACHE_DIR=
# Optional data locations (the Docker image ships the tracked 1-degree cubes).
# PIPELINE_DIR=
# CUBE_DIR=
# GRID_V2_DIR=
